                    <mxGeometry x="200" y="20" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="A single pipeline fans out to multiple p4p output spigots, each serving a different set of EPICS consumers." style="text;html=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#888888;" parent="1" vertex="1">
